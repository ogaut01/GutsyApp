{
  "rewrites": [
    {
      "source": "/producto/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ww]hats[Aa]pp|[Ff]acebook|[Ff]acebot|[Tt]witter|[Tt]elegram|[Dd]iscord|[Ss]lack|[Ll]inked[Ii]n|[Gg]ooglebot|opengraph|metatags).*"
        }
      ],
      "destination": "/api/og?path=:path*"
    },
    {
      "source": "/p/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ww]hats[Aa]pp|[Ff]acebook|[Ff]acebot|[Tt]witter|[Tt]elegram|[Dd]iscord|[Ss]lack|[Ll]inked[Ii]n|[Gg]ooglebot|opengraph|metatags).*"
        }
      ],
      "destination": "/api/og?path=:path*"
    },
    {
      "source": "/api/og",
      "destination": "/api/og"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://gutsy-backend-fpk3.onrender.com/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://gutsy-backend-fpk3.onrender.com/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
