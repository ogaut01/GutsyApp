# Variables de Entorno para Joyas & Accesorios PY (GutsyApp)

# Seguridad
DEBUG=False
SECRET_KEY=cambiar-por-una-clave-secreta-aleatoria-y-segura
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app,.vercel.app

# Dominios autorizados para CORS (Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-frontend.vercel.app

# Base de datos en Producción (PostgreSQL en Neon / Supabase / Railway)
# Dejar vacío en local para usar SQLite automáticamente
DATABASE_URL=

# Almacenamiento en la Nube para Fotos (Cloudinary)
# Opcional en desarrollo local, recomendado en producción
CLOUDINARY_URL=
